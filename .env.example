# Copy this file to ".env" in this same (project root) folder and fill it in. ".env" is excluded from version control and is never printed or logged.
# Leave GEMINI_API_KEY empty to run with the offline model (no network at all).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is busy or unavailable (HTTP 429/500/503/404).
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.7-flash
# Live weather for Tunisian cities from Open-Meteo is the ONLY web access. Off unless you set this to true.
ENABLE_WEB=false
